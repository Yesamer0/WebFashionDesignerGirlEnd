@using WebFashionDesignerGirl.Models
@model IEnumerable<WebFashionDesignerGirl.Models.LookbookViewModel>
@using Microsoft.AspNetCore.Http
@{
    Layout = "_Layout";
    ViewData["Title"] = "Moda Galerisi";
    var userId = Context.Session.GetInt32("UserId");
}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300;1,600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<!-- ══════════════════ HERO ══════════════════ -->
<section class="gl-hero">
    <span class="gl-tag">✦ Trend Raporu 2025</span>
    <h1 class="gl-hero-title">Moda<em>Galerisi</em></h1>
    <p class="gl-hero-sub">Topluluğun en ikonik kombinlerini keşfet, tarzını oyla ve ilham al.</p>
</section>

<!-- ══════════════════ FİLTRE ══════════════════ -->
<div class="gl-filters">
    <button class="gl-filter-btn active" data-filter="all">Tümü</button>
    <button class="gl-filter-btn" data-filter="casual">Casual</button>
    <button class="gl-filter-btn" data-filter="elegant">Elegant</button>
    <button class="gl-filter-btn" data-filter="streetwear">Streetwear</button>
    <button class="gl-filter-btn" data-filter="minimal">Minimal</button>
</div>

<!-- ══════════════════ GRİD ══════════════════ -->
<div class="gl-container">
    <div class="gl-grid" id="galleryGrid">

        @if (Model != null && Model.Any())
        {
            @foreach (var lb in Model)
            {
                <article class="gl-card"
                         data-id="@lb.Id"
                         data-category="@(lb.Category?.ToLower() ?? "all")"
                         onclick="openModal(@lb.Id, '@Html.Raw(lb.ImageUrl)', '@Html.Raw(lb.LookName?.Replace("'", "\'"))', '@Html.Raw(lb.OwnerName?.Replace("'", "\'"))', '@Html.Raw(lb.Description?.Replace("'", "\'"))', @lb.Points, @lb.Likes, '@(lb.IsLikedByMe ? "liked" : "")')">

                    <!-- Görsel -->
                    <div class="gl-img-wrap">
                        <img src="@lb.ImageUrl"
                             alt="@lb.LookName"
                             class="gl-img"
                             onerror="this.src='/images/default-outfit.jpg'" />

                        <!-- Hover overlay -->
                        <div class="gl-overlay">
                            <div class="gl-overlay-stats">
                                <span><i class="fas fa-heart"></i> @lb.Likes</span>
                                <span>✦ @lb.Points pt</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(lb.Category))
                        {
                            <span class="gl-cat-badge">@lb.Category</span>
                        }
                    </div>

                    <!-- Kart Alt Bilgi -->
                    <div class="gl-card-body">
                        <div class="gl-card-user">
                            <div class="gl-avatar">@(lb.OwnerName?.Substring(0, 1).ToUpper() ?? "?")</div>
                            <span class="gl-username">@lb.OwnerName</span>
                        </div>
                        <h3 class="gl-card-name">@lb.LookName</h3>
                        <div class="gl-card-stats">
                            <span class="gl-stat">
                                <i class="@(lb.IsLikedByMe ? "fas" : "far") fa-heart" style="color:@(lb.IsLikedByMe ? "#EC9C9D" : "inherit")"></i>
                                @lb.Likes
                            </span>
                            <span class="gl-stat">✦ @lb.Points pt</span>
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <div class="gl-empty">
                <div class="gl-empty-icon">👗</div>
                <h3>Henüz onaylı kombin yok</h3>
                <p>İlk kombini paylaşan sen ol!</p>
                @if (userId != null)
                {
                    <a href="/Lookbook/Create" class="gl-empty-btn">Kombin Oluştur ✦</a>
                }
            </div>
        }
    </div>
</div>

<!-- ══════════════════ MODAL ══════════════════ -->
<div class="gl-backdrop" id="glBackdrop" onclick="closeModal()"></div>

<div class="gl-modal" id="glModal">
    <button class="gl-modal-close" onclick="closeModal()">✕</button>

    <div class="gl-modal-body">
        <!-- Sol: Görsel -->
        <div class="gl-modal-img-side">
            <img id="mImg" src="" alt="" />
        </div>

        <!-- Sağ: Detay -->
        <div class="gl-modal-detail">

            <!-- Başlık -->
            <div class="gl-modal-header">
                <div class="gl-avatar gl-avatar-md" id="mAvatar"></div>
                <div>
                    <strong id="mOwner" class="gl-modal-owner"></strong>
                    <p id="mDate" class="gl-modal-date"></p>
                </div>
                <div id="mPoints" class="gl-modal-pts"></div>
            </div>

            <!-- Kombin Adı + Açıklama -->
            <div class="gl-modal-info">
                <h2 id="mTitle" class="gl-modal-title"></h2>
                <p id="mDesc" class="gl-modal-desc"></p>
            </div>

            <!-- Beğeni -->
            <div class="gl-modal-likes">
                <button id="mLikeBtn" class="gl-like-btn" onclick="toggleLike()">
                    <i class="far fa-heart"></i>
                    <span id="mLikeCount">0</span> beğeni
                </button>
            </div>

            <div class="gl-divider"></div>

            <!-- Yorumlar -->
            <div class="gl-comments" id="mComments">
                <div class="gl-loading">Yorumlar yükleniyor...</div>
            </div>

            <!-- Yorum Formu -->
            @if (userId != null)
            {
                <div class="gl-comment-form">
                    <input type="text" id="commentText" placeholder="Yorum ekle..." class="gl-comment-input" maxlength="200" />
                    <button onclick="submitComment()" class="gl-comment-send">Paylaş</button>
                </div>
            }
            else
            {
                <div class="gl-comment-login">
                    <a href="/Account/Login">Yorum yapmak için giriş yap →</a>
                </div>
            }
        </div>
    </div>
</div>

<!-- ══════════════════════════ STYLES ══════════════════════════ -->
<style>
    :root {
        --chocolate: #443025;
        --aloewood: #7F5836;
        --milktea: #AA7F66;
        --sakura: #EC9C9D;
        --blush: #F7E9EC;
        --cream: #FAF4F0;
    }

    /* ── Hero ────────────────────────────────── */
    .gl-hero {
        text-align: center;
        padding: 4rem 2rem 2rem;
        background: linear-gradient(180deg, var(--blush) 0%, var(--cream) 100%);
    }

    .gl-tag {
        font-size: 10px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--milktea);
        font-weight: 500;
        display: block;
        margin-bottom: 0.5rem;
    }

    .gl-hero-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2.8rem, 6vw, 5rem);
        font-weight: 600;
        color: var(--chocolate);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        line-height: 1;
        margin-bottom: 0.6rem;
    }

        .gl-hero-title em {
            font-style: italic;
            color: var(--sakura);
            font-weight: 300;
        }

    .gl-hero-sub {
        font-size: 0.9rem;
        color: var(--aloewood);
        font-weight: 300;
    }

    /* ── Filtreler ───────────────────────────── */
    .gl-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 1.25rem 3rem;
        background: var(--cream);
        border-bottom: 1px solid rgba(236,156,157,0.15);
        position: sticky;
        top: 148px;
        z-index: 10;
    }

    .gl-filter-btn {
        background: transparent;
        border: 1px solid rgba(236,156,157,0.3);
        color: var(--aloewood);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.06em;
        padding: 6px 18px;
        border-radius: 50px;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: all 0.2s;
    }

        .gl-filter-btn:hover {
            border-color: var(--sakura);
            color: var(--chocolate);
        }

        .gl-filter-btn.active {
            background: var(--chocolate);
            color: var(--cream);
            border-color: var(--chocolate);
        }

    /* ── Grid ────────────────────────────────── */
    .gl-container {
        padding: 2.5rem 3rem 5rem;
        max-width: 1300px;
        margin: 0 auto;
    }

    .gl-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.75rem;
    }

    /* ── Kart ────────────────────────────────── */
    .gl-card {
        background: #fff;
        border: 1px solid rgba(236,156,157,0.2);
        border-radius: 18px;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    }

        .gl-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 50px rgba(68,48,37,0.1);
            border-color: var(--sakura);
        }

    .gl-img-wrap {
        position: relative;
        aspect-ratio: 3/4;
        overflow: hidden;
    }

    .gl-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s;
    }

    .gl-card:hover .gl-img {
        transform: scale(1.04);
    }

    .gl-overlay {
        position: absolute;
        inset: 0;
        background: rgba(68,48,37,0.42);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s;
    }

    .gl-card:hover .gl-overlay {
        opacity: 1;
    }

    .gl-overlay-stats {
        display: flex;
        gap: 1.5rem;
        color: #fff;
        font-size: 1rem;
        font-weight: 500;
    }

    .gl-cat-badge {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(255,255,255,0.88);
        color: var(--aloewood);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 50px;
    }

    .gl-card-body {
        padding: 0.85rem 1rem 1rem;
    }

    .gl-card-user {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 0.4rem;
    }

    .gl-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--sakura), var(--milktea));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
        color: #fff;
        flex-shrink: 0;
        overflow: hidden;
    }

        .gl-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .gl-avatar-md {
        width: 40px;
        height: 40px;
        font-size: 14px;
    }

    .gl-username {
        font-size: 11px;
        color: var(--aloewood);
        font-weight: 500;
    }

    .gl-card-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1rem;
        font-weight: 600;
        color: var(--chocolate);
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }

    .gl-card-stats {
        display: flex;
        gap: 12px;
        align-items: center;
        border-top: 1px solid rgba(236,156,157,0.15);
        padding-top: 0.55rem;
        font-size: 11px;
        color: var(--aloewood);
    }

    .gl-stat {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ── Boş ─────────────────────────────────── */
    .gl-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 5rem 2rem;
        color: var(--aloewood);
    }

    .gl-empty-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
    }

    .gl-empty h3 {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.5rem;
        color: var(--chocolate);
        margin-bottom: 0.5rem;
    }

    .gl-empty p {
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
    }

    .gl-empty-btn {
        display: inline-block;
        background: var(--chocolate);
        color: var(--cream);
        padding: 10px 24px;
        border-radius: 50px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 500;
    }

    /* ══════════════ MODAL ══════════════ */
    .gl-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(44,28,18,0.6);
        z-index: 2000;
        backdrop-filter: blur(5px);
    }

        .gl-backdrop.open {
            display: block;
        }

    .gl-modal {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(94vw, 960px);
        max-height: 92vh;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        z-index: 2001;
        box-shadow: 0 32px 80px rgba(68,48,37,0.22);
    }

        .gl-modal.open {
            display: flex;
            flex-direction: column;
        }

    .gl-modal-close {
        position: absolute;
        top: 12px;
        right: 14px;
        background: rgba(255,255,255,0.9);
        border: 1px solid rgba(236,156,157,0.3);
        width: 30px;
        height: 30px;
        border-radius: 50%;
        font-size: 12px;
        cursor: pointer;
        color: var(--chocolate);
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .gl-modal-body {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        height: 90vh;
    }

    /* Sol görsel */
    .gl-modal-img-side {
        background: #1a1008;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .gl-modal-img-side img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    /* Sağ detay */
    .gl-modal-detail {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
    }

    .gl-modal-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 1rem 1.2rem;
        border-bottom: 1px solid rgba(236,156,157,0.15);
        flex-shrink: 0;
    }

    .gl-modal-owner {
        font-size: 13px;
        font-weight: 600;
        color: var(--chocolate);
        display: block;
    }

    .gl-modal-date {
        font-size: 10px;
        color: var(--milktea);
        margin: 0;
    }

    .gl-modal-pts {
        margin-left: auto;
        background: rgba(236,156,157,0.12);
        color: var(--aloewood);
        font-size: 11px;
        font-weight: 500;
        padding: 4px 12px;
        border-radius: 50px;
        border: 1px solid rgba(236,156,157,0.25);
        white-space: nowrap;
    }

    .gl-modal-info {
        padding: 0.85rem 1.2rem 0.5rem;
        flex-shrink: 0;
    }

    .gl-modal-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.3rem;
        font-weight: 600;
        color: var(--chocolate);
        margin-bottom: 0.3rem;
    }

    .gl-modal-desc {
        font-size: 13px;
        color: var(--aloewood);
        line-height: 1.6;
        margin: 0;
    }

    .gl-modal-likes {
        padding: 0.5rem 1.2rem;
        flex-shrink: 0;
    }

    .gl-like-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: none;
        border: none;
        cursor: pointer;
        font-size: 13px;
        font-weight: 500;
        color: var(--aloewood);
        font-family: 'DM Sans', sans-serif;
        padding: 5px 12px;
        border-radius: 50px;
        transition: all 0.2s;
    }

        .gl-like-btn:hover {
            background: var(--blush);
            color: var(--sakura);
        }

        .gl-like-btn.liked {
            color: var(--sakura);
        }

            .gl-like-btn.liked i {
                color: var(--sakura);
            }

    .gl-divider {
        height: 1px;
        background: rgba(236,156,157,0.15);
        margin: 0 1.2rem;
        flex-shrink: 0;
    }

    /* Yorumlar */
    .gl-comments {
        flex: 1;
        overflow-y: auto;
        padding: 0.75rem 1.2rem;
    }

        .gl-comments::-webkit-scrollbar {
            width: 3px;
        }

        .gl-comments::-webkit-scrollbar-thumb {
            background: rgba(236,156,157,0.4);
            border-radius: 2px;
        }

    .gl-comment-item {
        display: flex;
        gap: 8px;
        margin-bottom: 0.9rem;
    }

    .gl-comment-body {
        flex: 1;
    }

    .gl-comment-meta {
        display: flex;
        align-items: baseline;
        gap: 7px;
        margin-bottom: 2px;
    }

    .gl-comment-user {
        font-size: 12px;
        font-weight: 600;
        color: var(--chocolate);
        text-decoration: none;
    }

    .gl-comment-time {
        font-size: 10px;
        color: var(--milktea);
    }

    .gl-comment-text {
        font-size: 13px;
        color: var(--aloewood);
        line-height: 1.5;
    }

    .gl-loading {
        text-align: center;
        color: var(--milktea);
        font-size: 13px;
        padding: 2rem 0;
    }

    .gl-no-comments {
        text-align: center;
        color: var(--milktea);
        font-size: 13px;
        padding: 1.5rem 0;
    }

    /* Yorum formu */
    .gl-comment-form {
        display: flex;
        gap: 8px;
        align-items: center;
        padding: 0.75rem 1.2rem;
        border-top: 1px solid rgba(236,156,157,0.15);
        flex-shrink: 0;
    }

    .gl-comment-input {
        flex: 1;
        border: 1px solid rgba(236,156,157,0.3);
        border-radius: 50px;
        padding: 8px 14px;
        font-size: 13px;
        font-family: 'DM Sans', sans-serif;
        color: var(--chocolate);
        background: var(--cream);
        outline: none;
        transition: border-color 0.2s;
    }

        .gl-comment-input:focus {
            border-color: var(--sakura);
        }

    .gl-comment-send {
        background: var(--chocolate);
        color: var(--cream);
        border: none;
        padding: 8px 18px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        font-family: 'DM Sans', sans-serif;
        transition: background 0.2s;
        white-space: nowrap;
    }

        .gl-comment-send:hover {
            background: var(--aloewood);
        }

    .gl-comment-login {
        padding: 0.75rem 1.2rem;
        text-align: center;
        border-top: 1px solid rgba(236,156,157,0.15);
        font-size: 13px;
        flex-shrink: 0;
    }

        .gl-comment-login a {
            color: var(--sakura);
            text-decoration: none;
            font-weight: 500;
        }

    /* ── Responsive ──────────────────────────── */
    @@media (max-width: 900px) {
        .gl-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .gl-modal-body {
            grid-template-columns: 1fr;
        }

        .gl-modal-img-side {
            height: 260px;
        }

        .gl-modal-detail {
            max-height: 60vh;
        }

        .gl-filters {
            top: 110px;
            padding: 1rem 1.5rem;
        }

        .gl-container {
            padding: 2rem 1.5rem 4rem;
        }
    }

    @@media (max-width: 580px) {
        .gl-grid {
            grid-template-columns: 1fr;
        }

        .gl-container {
            padding: 1.5rem 1rem 4rem;
        }
    }
</style>

<script>
    let currentId = 0;

    /* ── Modal Aç ──────────────────────────── */
    function openModal(id, img, title, owner, desc, points, likes, likedClass) {
        currentId = id;

        document.getElementById('mImg').src = img || '/images/default-outfit.jpg';
        document.getElementById('mTitle').textContent = title || '';
        document.getElementById('mOwner').textContent = owner || '';
        document.getElementById('mDesc').textContent = desc || '';
        document.getElementById('mPoints').textContent = '✦ ' + points + ' pt';
        document.getElementById('mLikeCount').textContent = likes;

        // Avatar
        const av = document.getElementById('mAvatar');
        av.textContent = (owner?.charAt(0)?.toUpperCase()) || '?';

        // Beğeni butonu
        const likeBtn = document.getElementById('mLikeBtn');
        const likeIcon = likeBtn.querySelector('i');
        if (likedClass === 'liked') {
            likeBtn.classList.add('liked');
            likeIcon.className = 'fas fa-heart';
        } else {
            likeBtn.classList.remove('liked');
            likeIcon.className = 'far fa-heart';
        }

        loadComments(id);

        document.getElementById('glBackdrop').classList.add('open');
        document.getElementById('glModal').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    /* ── Modal Kapat ───────────────────────── */
    function closeModal() {
        document.getElementById('glBackdrop').classList.remove('open');
        document.getElementById('glModal').classList.remove('open');
        document.body.style.overflow = '';
        currentId = 0;
    }

    /* ── Yorumları Yükle ───────────────────── */
    async function loadComments(id) {
        const container = document.getElementById('mComments');
        container.innerHTML = '<div class="gl-loading">Yorumlar yükleniyor...</div>';

        const resp = await fetch('/Lookbook/GetComments?lookbookId=' + id);
        const comments = await resp.json();

        if (!comments || comments.length === 0) {
            container.innerHTML = '<div class="gl-no-comments">Henüz yorum yok. İlk yorumu sen yaz! 🎀</div>';
            return;
        }

        container.innerHTML = comments.map(c => `
            <div class="gl-comment-item">
                <div class="gl-avatar">
                    ${(c.username?.charAt(0)?.toUpperCase()) || '?'}
                </div>
                <div class="gl-comment-body">
                    <div class="gl-comment-meta">
                        <span class="gl-comment-user">${escHtml(c.username)}</span>
                        <span class="gl-comment-time">${c.date}</span>
                    </div>
                    <p class="gl-comment-text">${escHtml(c.text)}</p>
                </div>
            </div>
        `).join('');
    }

    /* ── Yorum Gönder ──────────────────────── */
    async function submitComment() {
        const input = document.getElementById('commentText');
        const text = input.value.trim();
        if (!text || !currentId) return;

        const resp = await fetch('/Lookbook/AddComment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lookbookId: currentId, text: text })
        });
        const res = await resp.json();
        if (res.success) {
            input.value = '';
            loadComments(currentId);
        } else {
            alert(res.message || 'Bir hata oluştu.');
        }
    }

    /* ── Beğeni Toggle ─────────────────────── */
    async function toggleLike() {
        if (!currentId) return;

        const resp = await fetch('/Lookbook/ToggleLike', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lookbookId: currentId })
        });
        const res = await resp.json();

        if (res.success) {
            const likeBtn = document.getElementById('mLikeBtn');
            const likeIcon = likeBtn.querySelector('i');
            document.getElementById('mLikeCount').textContent = res.likeCount;
            document.getElementById('mPoints').textContent = '✦ ' + res.points + ' pt';

            if (res.liked) {
                likeBtn.classList.add('liked');
                likeIcon.className = 'fas fa-heart';
            } else {
                likeBtn.classList.remove('liked');
                likeIcon.className = 'far fa-heart';
            }

            // Karttaki istatistiği de güncelle
            const card = document.querySelector('.gl-card[data-id="' + currentId + '"]');
            if (card) {
                const statSpans = card.querySelectorAll('.gl-stat');
                statSpans[0].innerHTML = `<i class="${res.liked ? 'fas' : 'far'} fa-heart" style="color:${res.liked ? '#EC9C9D' : 'inherit'}"></i> ${res.likeCount}`;
                statSpans[1].textContent = '✦ ' + res.points + ' pt';
            }
        } else {
            alert(res.message || 'Giriş yapmalısın!');
        }
    }

    /* ── Filtrele ──────────────────────────── */
    document.querySelectorAll('.gl-filter-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.gl-filter-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');
            const filter = this.dataset.filter;
            document.querySelectorAll('.gl-card').forEach(card => {
                card.style.display = (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
            });
        });
    });

    /* ── Klavye & Yardımcı ─────────────────── */
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
    document.getElementById('commentText')?.addEventListener('keydown', e => { if (e.key === 'Enter') submitComment(); });

    function escHtml(str) {
        if (!str) return '';
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
</script>
