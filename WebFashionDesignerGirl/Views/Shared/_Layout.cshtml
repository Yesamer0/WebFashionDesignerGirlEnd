<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Fashion Girl</title>

    @* Google Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400;1,700&family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300;1,600&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

    @* DÜZELTİLEN KISIM: Yerel bootstrap yerine 404 vermeyen güvenli online CDN sürümü bağlandı *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --chocolate: #443025;
            --aloewood: #7F5836;
            --milktea: #AA7F66;
            --sakura: #EC9C9D;
            --blush: #F7E9EC;
            --cream: #FAF4F0;
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--cream);
            color: var(--chocolate);
            font-family: 'DM Sans', sans-serif;
            padding-top: 0;
            /* KRİTİK: Cursor:none hatasını buradan temizledik */
            cursor: default !important;
            pointer-events: auto !important;
        }

        .site-header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: var(--cream);
            box-shadow: 0 1px 0 rgba(236,156,157,0.18);
        }

        .nav-topbar {
            background: var(--chocolate);
            padding: 5px 3rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .nav-topbar span {
                font-size: 10px;
                letter-spacing: 0.14em;
                text-transform: uppercase;
                color: rgba(247,233,236,0.65);
            }

        .nav-logo-bar {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 18px 3rem 10px;
            border-bottom: 1px solid rgba(236,156,157,0.2);
        }

        .nav-logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.6rem;
            font-weight: 600;
            color: var(--chocolate);
            letter-spacing: 0.12em;
            text-transform: uppercase;
            text-decoration: none;
        }

            .nav-logo em {
                font-style: italic;
                color: var(--sakura);
            }

        .nav-links-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 3rem;
            height: 46px;
            border-bottom: 1px solid rgba(236,156,157,0.15);
        }

        .nav-links-left, .nav-links-right {
            display: flex;
            gap: 2.25rem;
            list-style: none;
            align-items: center;
            margin-bottom: 0;
        }

            .nav-links-left a, .nav-links-right a {
                font-size: 10px;
                letter-spacing: 0.16em;
                text-transform: uppercase;
                color: var(--aloewood);
                text-decoration: none;
                font-weight: 500;
                transition: 0.2s;
            }

                .nav-links-left a:hover, .nav-links-left a.active {
                    color: var(--chocolate);
                    border-bottom: 1.5px solid var(--sakura);
                }

        .nav-btn-primary {
            background: var(--chocolate);
            color: var(--cream);
            padding: 7px 18px;
            border-radius: 50px;
            font-size: 10px;
            text-transform: uppercase;
            text-decoration: none;
        }

        .nav-btn-ghost {
            border: 1px solid rgba(236,156,157,0.4);
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 10px;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--aloewood);
        }

        main {
            min-height: calc(100vh - 180px);
        }

        .site-footer {
            background: var(--chocolate);
            color: rgba(247,233,236,0.6);
            text-align: center;
            padding: 2rem;
            font-size: 11px;
        }
    </style>
</head>
<body>

    <header class="site-header">
        <div class="nav-topbar">
            <div class="nav-topbar-left" style="display:flex; gap:1.5rem;">
                <span>Yeni Koleksiyon @DateTime.Now.Year</span>
                <span>Stil Puanları Kazan</span>
            </div>
            <div class="nav-topbar-right" style="color:var(--sakura); font-size:10px;">✦ CAPSULE WARDROBE</div>
        </div>

        <div class="nav-logo-bar">
            <div class="nav-logo-wrap" style="text-align:center;">
                <a href="/" class="nav-logo">Fashion<em>Girl</em></a>
                <span style="display:block; font-size:8.5px; letter-spacing:0.28em; color:var(--milktea); text-transform:uppercase;">Digital Capsule Wardrobe</span>
            </div>
        </div>

        <nav class="nav-links-bar">
            <ul class="nav-links-left">
                <li><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                <li><a asp-controller="Lookbook" asp-action="Index">Lookbook</a></li>
                <li><a asp-controller="Studio" asp-action="Index">Stüdyo</a></li>
            </ul>

            <ul class="nav-links-right">
                <li><a asp-controller="Community" asp-action="Index">Topluluk</a></li>
                @if (Context.Session.GetString("Role") == "Admin")
                {
                    <li><a href="/Admin/ClothingItems">Kıyafet Kataloğu</a></li>
                }
                @if (Context.Session.GetInt32("UserId") == null)
                {
                    <li><a href="/Account/Login" class="nav-btn-ghost">Kayıt Ol</a></li>
                    <li><a href="/Account/Login" class="nav-btn-primary">Giriş Yap</a></li>
                }
                else
                {
                    <li><a href="/Account/Profile" class="nav-btn-ghost">Profilim</a></li>
                    <li><a href="/Account/Logout" class="nav-btn-primary">Çıkış</a></li>
                }
            </ul>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <span style="font-family:'Cormorant Garamond'; font-size:1.4rem; color:var(--blush);">Fashion<em>Girl</em></span>
        <p>&copy; @DateTime.Now.Year — Digital Capsule Wardrobe</p>
    </footer>

    @* DÜZELTİLEN KISIM: 404 Kilitlenmesini önlemek için scriptler online ve kararlı kaynaklarla (CDN) değiştirildi *@
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Sayfa yüklendiğinde mouse imlecini ve tıklamaları zorla aktif et
        document.addEventListener('DOMContentLoaded', function() {
            document.body.style.cursor = 'default';

            // Aktif linki işaretle
            const path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.nav-links-left a, .nav-links-right a').forEach(link => {
                const href = link.getAttribute('href');
                if (href && path.includes(href.toLowerCase())) {
                    link.classList.add('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>