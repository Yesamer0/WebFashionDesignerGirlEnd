@model IEnumerable<WebFashionDesignerGirl.Models.AppUser>

@{
    ViewData["Title"] = "Üye Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="color: #4a4a4a; font-weight: 600; font-family: 'Poppins', sans-serif;">Üye Yönetimi</h2>
            <p class="text-muted small">Şu an @Model.Count() tasarımcıyı görüntülüyorsun.</p>
        </div>
        <div>
            <a href="/Account/Profile" class="btn btn-outline-secondary shadow-sm" style="border-radius: 10px; font-size: 0.9rem; border-color: #eee; color: #666; font-weight: 500;">
                👤 Kendi Profilime Dön
            </a>
        </div>
    </div>

    <div class="mb-4">
        <input type="text" id="searchInput" onkeyup="tabloyuFiltrele()" class="form-control shadow-sm" placeholder="İsim veya Moda Adı ile ara..." style="border-radius: 12px; border: 1px solid #eee; padding: 12px 20px; font-size: 0.9rem;">
    </div>

    <div class="card shadow-sm border-0" style="border-radius: 15px;">
        <div class="card-body p-0">
            <table class="table mb-0" id="userTable">
                <thead style="background-color: #fcfcfc; color: #888; font-size: 0.75rem; letter-spacing: 1px; text-transform: uppercase;">
                    <tr>
                        <th class="border-0 py-3 px-4">TASARIMCI BİLGİSİ</th>
                        <th class="border-0 py-3 text-right px-4">AKSİYON</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr class="user-row" style="border-top: 1px solid #f9f9f9;">
                            <td class="py-3 px-4">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle d-flex justify-content-center align-items-center mr-3"
                                         style="width: 38px; height: 38px; background-color: #fff0f3; color: #ff85a2; font-weight: bold; border: 1px solid #ffe4e8;">
                                        @user.UserName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div style="color: #333; font-weight: 500; font-size: 0.95rem;">@user.UserName</div>
                                        <div class="text-muted" style="font-size: 0.8rem;">@("@")@user.ModaAdi</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 text-right px-4">
                                <a href="/Account/Profile/@user.Id" class="btn btn-sm"
                                   style="background-color: #ff85a2; color: white; border-radius: 8px; padding: 6px 20px; font-size: 0.8rem; font-weight: 500; border: none;">
                                    Profile Git
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #fdfdfd;
        font-family: 'Poppins', sans-serif;
    }

    .user-row:hover {
        background-color: #fffafb;
        transition: 0.2s;
    }

    .btn:hover {
        opacity: 0.85;
        transform: translateY(-1px);
        text-decoration: none;
        color: inherit;
    }

    .form-control:focus {
        border-color: #ff85a2;
        box-shadow: 0 0 0 0.2rem rgba(255, 133, 162, 0.08);
        outline: none;
    }

    /* Mobilde de düzgün durması için */
    .table td {
        vertical-align: middle;
    }
</style>

<script>
    // Arama yapınca tabloyu anlık filtreleyen kod
    function tabloyuFiltrele() {
        var input = document.getElementById("searchInput");
        var filter = input.value.toUpperCase();
        var table = document.getElementById("userTable");
        var tr = table.getElementsByClassName("user-row");

        for (var i = 0; i < tr.length; i++) {
            var textContent = tr[i].textContent || tr[i].innerText;
            if (textContent.toUpperCase().indexOf(filter) > -1) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }
</script>